# --- Tailscale (required) ---
# Reusable, pre-authorized auth key from https://login.tailscale.com/admin/settings/keys
# Tag it (e.g. tag:mcp) so ACLs can scope who may reach the MCP.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# TS_EXTRA_ARGS=--advertise-tags=tag:mcp

# --- Azure Key Vault (required) ---
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# Optional service principal; otherwise DefaultAzureCredential (managed identity, az login, ...)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- UniFi ---
# Tailscale IP or MagicDNS name of the UniFi console / subnet-routed LAN address.
# Leave empty to read the 'unifi-controller-url' secret from Key Vault instead.
UNIFI_CONTROLLER_URL=https://100.x.x.x
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false

# --- MCP (required) ---
# Generate: openssl rand -base64 32
MCP_AUTH_TOKEN=
