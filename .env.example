# Azure Key Vault
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/

# Optional: explicit service principal (otherwise DefaultAzureCredential is used)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Key Vault secret names
UNIFI_API_KEY_SECRET_NAME=unifi-api-key
UNIFI_CONTROLLER_URL_SECRET_NAME=unifi-controller-url
UNIFI_USERNAME_SECRET_NAME=unifi-username
UNIFI_PASSWORD_SECRET_NAME=unifi-password

# UniFi (env overrides Key Vault when set)
# UNIFI_CONTROLLER_URL=https://192.168.1.1
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false
UNIFI_REQUEST_TIMEOUT_SECONDS=30

# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_TRANSPORT=streamable-http
# MCP_AUTH_TOKEN=change-me-for-production
