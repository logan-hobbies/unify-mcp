# Azure Key Vault
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/

# Optional: explicit service principal (otherwise DefaultAzureCredential is used)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# UniFi (env overrides Key Vault when set)
# UNIFI_CONTROLLER_URL=https://192.168.1.1
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false

# MCP server
MCP_AUTH_TOKEN=

# ASP.NET Core / MCP settings map automatically via docker-compose environment section
