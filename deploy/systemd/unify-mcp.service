[Unit]
Description=UniFi Read-Only MCP Server (.NET)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unify
Group=unify
WorkingDirectory=/opt/unify-mcp
EnvironmentFile=/etc/unify-mcp/env
ExecStart=/usr/bin/dotnet /opt/unify-mcp/UnifyMcp.dll
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
