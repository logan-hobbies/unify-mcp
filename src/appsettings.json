{
  "AzureKeyVault": {
    "VaultUrl": "https://your-vault.vault.azure.net/",
    "UnifiApiKeySecretName": "unifi-api-key",
    "UnifiControllerUrlSecretName": "unifi-controller-url",
    "UnifiUsernameSecretName": "unifi-username",
    "UnifiPasswordSecretName": "unifi-password"
  },
  "Unifi": {
    "ControllerUrl": null,
    "Site": "default",
    "VerifySsl": false,
    "RequestTimeoutSeconds": 30
  },
  "Mcp": {
    "Host": "0.0.0.0",
    "Port": 8080,
    "Transport": "streamable-http",
    "AuthToken": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
